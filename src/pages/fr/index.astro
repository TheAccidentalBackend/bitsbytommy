---
const title = 'Création de site web à Gistel | Bits by Tommy';
const description = 'Création de sites web personnels et abordables à Gistel et environs. Un site clair, sur mesure, qui vous appartient et peut évoluer avec votre activité.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Bits by Tommy',
	url: canonicalURL.href,
	email: 'vercruyssetommy@telenet.be',
	telephone: '+32493767863',
	description,
	areaServed: { '@type': 'City', name: 'Gistel' },
	founder: { '@type': 'Person', name: 'Tommy' },
	knowsLanguage: ['nl', 'fr', 'en'],
	serviceType: 'Création de sites web',
};
const faqData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Combien coûte environ un site web ?',
			acceptedAnswer: { '@type': 'Answer', text: 'Un site web simple d’une page coûte généralement environ 500 € hors TVA. Pour un site simple comprenant jusqu’à trois pages, comptez environ 750 € hors TVA. Il s’agit de prix indicatifs. Le sur-mesure, les animations et les fonctions spécifiques influencent la quantité de travail nécessaire.' },
		},
		{
			'@type': 'Question',
			name: 'Le site web m’appartient-il vraiment ?',
			acceptedAnswer: { '@type': 'Answer', text: 'Oui. Vous achetez votre site, vous ne le louez pas. Aucun abonnement de maintenance n’est imposé. Votre nom de domaine reste le principal coût annuel fixe, sauf si vous choisissez des services payants supplémentaires.' },
		},
		{
			'@type': 'Question',
			name: 'Puis-je modifier mon site moi-même ?',
			acceptedAnswer: { '@type': 'Answer', text: 'Oui. Vous pouvez facilement modifier les textes, photos, prix et autres contenus existants. Pour de nouvelles pages ou fonctions, nous définissons ensemble une extension claire.' },
		},
		{
			'@type': 'Question',
			name: 'Travaillez-vous uniquement avec des clients de Gistel ?',
			acceptedAnswer: { '@type': 'Answer', text: 'Non. Depuis Gistel, Bits by Tommy travaille avec des indépendants, associations et projets dans les environs et au-delà. Une grande partie du processus peut facilement se dérouler à distance.' },
		},
	],
};
---

<html lang="fr-BE">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="nl-BE" href="https://bitsbytommy.be/" />
		<link rel="alternate" hreflang="fr-BE" href="https://bitsbytommy.be/fr/" />
		<link rel="alternate" hreflang="en" href="https://bitsbytommy.be/en/" />
		<link rel="alternate" hreflang="x-default" href="https://bitsbytommy.be/" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_BE" />
		<meta property="og:site_name" content="Bits by Tommy" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqData)} />
		<title>{title}</title>
	</head>
	<body id=top>
		<header>
			<a href=/>bits <small>BY TOMMY</small></a>
			<div class=header-actions>
				<nav class=language-switcher aria-label=Langue><a href=/>NL</a><a href=/fr/ aria-current=page>FR</a><a href=/en/>EN</a></nav>
				<a class=header-cta href=#contact>Parlez-moi de votre projet</a>
			</div>
		</header>
		<nav class=side-nav aria-label='Navigation principale'>
			<a href=#services data-secondary><b>Vision</b><i aria-hidden=true></i><span>01</span></a>
			<a href=#portfolio><b>Portfolio</b><i aria-hidden=true></i><span>02</span></a>
			<a href=#approach data-secondary><b>Méthode</b><i aria-hidden=true></i><span>03</span></a>
			<a href=#pricing><b>Tarifs</b><i aria-hidden=true></i><span>04</span></a>
			<a href=#faq><b>FAQ</b><i aria-hidden=true></i><span>05</span></a>
			<a href=#about data-secondary><b>À propos</b><i aria-hidden=true></i><span>06</span></a>
			<a href=#contact><b>Contact</b><i aria-hidden=true></i><span>07</span></a>
		</nav>
		<main><section>
			<p class=eyebrow>Création de site web à Gistel</p>
			<h1>Votre idée. Mes bits. <em>Un site qui vous correspond.</em></h1>
			<p class=intro>Je découvre votre activité, votre organisation ou votre idée et je la transforme en un site clair, abordable et doté de sa propre personnalité.</p>
			<a class=button href=#contact>Parlez-moi de votre idée ↘</a>
			<p class=languages>Pour les indépendants, les associations et les personnes qui ont une bonne idée.</p>
		</section>
		<section class=services id=services aria-labelledby=services-title>
			<div class=section-heading>
				<p class=eyebrow>Ma façon de créer</p>
				<h2 id=services-title>Pas de formules rigides. Une vraie discussion.</h2>
			</div>
			<div class=service-stack>
				<article class=service-panel>
					<div class=panel-top><span>01 / VOUS</span><span>VOTRE CONTRIBUTION</span></div>
					<div><h3>Vous connaissez votre histoire.</h3><p>J’écoute ce que vous faites, pour qui vous le faites et où vous souhaitez aller. Ces connaissances forment la base du design.</p></div>
					<strong>Votre contribution donne la direction. Je la transforme en site web.</strong>
				</article>
				<article class=service-panel>
					<div class=panel-top><span>02 / SIMPLICITÉ</span><span>UNIQUEMENT L’UTILE</span></div>
					<div><h3>La simplicité est un choix.</h3><p>Une structure claire, des images fortes et des détails bien pensés. Chaque élément a une raison d’être. Rien ne gêne votre visiteur.</p></div>
					<strong>Agréable à regarder. Logique à utiliser.</strong>
				</article>
				<article class=service-panel>
					<div class=panel-top><span>03 / VALEUR</span><span>BUDGET HONNÊTE</span></div>
					<div><h3>Abordable avec du caractère.</h3><p>Un site abordable ne doit pas paraître bon marché. Vous payez pour un design réfléchi et un travail solide, pas pour le nom d’une grande agence.</p></div>
					<strong>Un site original sans facture incompréhensible.</strong>
				</article>
			</div>
		</section>
		<section class=portfolio id=portfolio aria-labelledby=portfolio-title>
			<div class=portfolio-heading>
				<p class=eyebrow>Portfolio</p>
				<h2 id=portfolio-title>Un projet. Tout à fait réel.</h2>
				<p>Mon portfolio grandit avec Bits by Tommy. Voici où il commence aujourd’hui.</p>
			</div>
			<a class=project-card href=https://maramusic.be/ target=_blank rel=noreferrer>
				<div class=project-visual>
					<span class=project-window>maramusic.be</span>
					<img src=/mara-portfolio.png alt='Exemple du site multilingue pour artiste Maramusic.be' loading=lazy />
				</div>
				<div class=project-info>
					<div><span>01 / MUSIQUE</span><h3>Maramusic.be</h3><p>Un site multilingue pour artiste</p></div>
					<strong>Voir le site ↗</strong>
				</div>
			</a>
		</section>
		<section class=approach id=approach aria-labelledby=approach-title>
			<div class=approach-copy>
				<p class=eyebrow>Un parcours clair</p>
				<h2 id=approach-title>D’abord écouter. Ensuite créer.</h2>
				<p>Nous établissons le plan ensemble. Je prends ensuite en charge le design et la réalisation. À des moments convenus, vous pouvez suivre le résultat et l’orienter si nécessaire.</p>
			</div>
			<ol class=process>
				<li><span>01</span><div><h3>Comprendre d’abord</h3><p>Nous discutons de votre histoire, de votre public et de ce que le site doit accomplir.</p></div></li>
				<li><span>02</span><div><h3>Un plan clair</h3><p>Je transforme notre échange en une proposition concrète avec une structure, un prix et un planning clairs.</p></div></li>
				<li><span>03</span><div><h3>Design et réalisation</h3><p>Je travaille ensuite de manière autonome. Aux moments convenus, nous examinons le résultat et rassemblons vos remarques.</p></div></li>
			</ol>
		</section>
		<section class=pricing id=pricing aria-labelledby=pricing-title>
			<div class=pricing-heading>
				<p class=eyebrow>Prix indicatifs</p>
				<h2 id=pricing-title>Commencer clairement. Garder la liberté d’évoluer.</h2>
				<p>Pas de formules rigides auxquelles vous devez vous adapter. Deux exemples clairs pour estimer votre budget.</p>
			</div>
			<div class=price-options>
				<article>
					<div><span>UNE PAGE</span><strong>± 500 € <small>hors TVA</small></strong></div>
					<h3>Tout sur une page forte.</h3>
					<ul>
						<li>Design sur mesure</li>
						<li><strong>Une page claire à faire défiler</strong></li>
						<li>Adapté au mobile, à la tablette et à l’ordinateur</li>
						<li>Coordonnées et boutons de contact cliquables</li>
						<li><strong>Base technique SEO</strong></li>
						<li>Une série de retours regroupés</li>
						<li>Publication et configuration technique</li>
					</ul>
				</article>
				<article>
					<div><span>JUSQU’À TROIS PAGES</span><strong>± 750 € <small>hors TVA</small></strong></div>
					<h3>Plus d’espace pour votre histoire.</h3>
					<ul>
						<li>Design sur mesure</li>
						<li><strong>Jusqu’à trois pages distinctes</strong></li>
						<li>Adapté au mobile, à la tablette et à l’ordinateur</li>
						<li>Coordonnées et boutons de contact cliquables</li>
						<li><strong>Un titre et une description SEO propres à chaque page</strong></li>
						<li>Une série de retours regroupés</li>
						<li>Publication et configuration technique</li>
					</ul>
				</article>
				<p class=price-note>Les textes et les images sont fournis par le client. Les boutiques en ligne, le multilinguisme et les fonctions particulières ne sont pas inclus et sont discutés séparément au préalable.</p>
			</div>
			<p class=pricing-context>Il s’agit de prix indicatifs, pas de formules fixes. Une page très personnalisée avec des animations ou des fonctions spécifiques peut demander plus de travail que trois pages simples. Vous recevez toujours un prix clair à l’avance.</p>
		</section>
		<section class=ownership id=ownership aria-labelledby=ownership-title>
			<div>
				<p class=eyebrow>Une propriété honnête</p>
				<h2 id=ownership-title>Vous achetez votre site. Vous ne le louez pas.</h2>
			</div>
			<div class=ownership-copy>
				<p>Le site que je crée pour vous vous appartient. Aucun abonnement de maintenance obligatoire et aucune facture mensuelle simplement pour garder votre propre site en ligne.</p>
				<ul>
					<li><span>MODIFIER</span><p>Modifiez facilement vous-même les textes, photos, prix, menus et autres contenus existants.</p></li>
					<li><span>FAIRE ÉVOLUER</span><p>Besoin d’une nouvelle page, d’un lien ou d’une fonction plus tard ? Vous recevez une proposition claire à l’avance.</p></li>
					<li><span>COÛT ANNUEL</span><p>Votre nom de domaine reste votre seul coût fixe, sauf si vous choisissez un service payant supplémentaire.</p></li>
				</ul>
			</div>
		</section>
		<section class=faq id=faq aria-labelledby=faq-title>
			<div class=faq-heading>
				<p class=eyebrow>Questions fréquentes</p>
				<h2 id=faq-title>Créer un site sans points d’interrogation.</h2>
			</div>
			<div class=faq-list>
				<details><summary>Combien coûte environ un site web ?</summary><p>Un site web simple d’une page coûte généralement environ 500 € hors TVA. Pour un site simple comprenant jusqu’à trois pages, comptez environ 750 € hors TVA. Il s’agit de prix indicatifs. Le sur-mesure, les animations et les fonctions spécifiques influencent la quantité de travail nécessaire.</p></details>
				<details><summary>Le site web m’appartient-il vraiment ?</summary><p>Oui. Vous achetez votre site, vous ne le louez pas. Aucun abonnement de maintenance n’est imposé. Votre nom de domaine reste le principal coût annuel fixe, sauf si vous choisissez des services payants supplémentaires.</p></details>
				<details><summary>Puis-je modifier mon site moi-même ?</summary><p>Oui. Vous pouvez facilement modifier les textes, photos, prix et autres contenus existants. Pour de nouvelles pages ou fonctions, nous définissons ensemble une extension claire.</p></details>
				<details><summary>Travaillez-vous uniquement avec des clients de Gistel ?</summary><p>Non. Depuis Gistel, je travaille avec des indépendants, associations et projets dans les environs et au-delà. Une grande partie du processus peut facilement se dérouler à distance.</p></details>
			</div>
		</section>
		<section class=about id=about aria-labelledby=about-title>
			<div class=about-marker aria-hidden=true>
				<span>11</span>
				<small>ANS<br />LÀ OÙ TOUT A COMMENCÉ</small>
			</div>
			<div class=about-copy>
				<p class=eyebrow>À propos de Tommy</p>
				<h2 id=about-title>Une ancienne curiosité. Un nouvel enthousiasme.</h2>
				<p>À onze ans, j’installais déjà des ordinateurs sous Windows 98 et j’expérimentais avec mes premiers sites web. J’ai créé mes premiers véritables sites il y a une vingtaine d’années.</p>
				<p>La technologie est ensuite toujours restée présente dans ma vie et mon travail, même si le webdesign n’a pas toujours été au centre. Ces dernières années, l’envie est revenue. Cette année, j’ai décidé de m’y consacrer sérieusement, avec des idées fraîches et des outils modernes.</p>
				<p>En parallèle de Bits by Tommy, je travaille à temps plein comme technicien de service dans les télécoms. À la maison, je suis avant tout compagnon et papa. Et lorsqu’il reste une soirée, je refuse rarement une bonne session de jeu.</p>
				<p class=about-signoff>Je veux créer quelque chose dont nous pouvons être fiers tous les deux. Personnel, compréhensible et sans coûts inutiles.</p>
			</div>
		</section>
	</main>
		<footer id=contact>
			<div><small>CRÉATION DE SITES À GISTEL ET ENVIRONS</small><p>Vous avez une idée en tête ?</p></div>
			<div class=contact-action>
				<span>Parlez-m’en, même si votre idée n’est pas encore complètement définie.</span>
				<div class=contact-links>
					<a href=mailto:vercruyssetommy@telenet.be>vercruyssetommy@telenet.be ↗</a>
					<a href=tel:+32493767863>0493 76 78 63 ↗</a>
				</div>
			</div>
		</footer>
		<a class=to-top href=#top aria-label='Retour en haut'>↑</a>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Manrope:wght@400;500;600&display=swap');
	:root { color-scheme: dark; font-family: 'Manrope', sans-serif; background: #0b0d0f; color: #f2f0ea; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; background: radial-gradient(circle at 78% 22%, rgb(143 41 66 / 12%), transparent 28rem), #0b0d0f; }
	a { color: inherit; }
	header { display: flex; align-items: center; justify-content: space-between; max-width: 90rem; margin: 0 auto; padding: 1.75rem clamp(1.5rem, 5vw, 5rem); border-bottom: 1px solid rgb(242 240 234 / 10%); }
	header a { font-size: .85rem; text-underline-offset: .35rem; }
	header > a:first-child { font-size: 1.65rem; font-weight: 600; letter-spacing: -.08em; text-decoration: none; }
	header small, .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: .68rem; letter-spacing: .14em; }
	header small { margin-left: .75rem; color: #9ba1a8; }
	.header-actions { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
	.language-switcher { display: flex; gap: .65rem; }
	.language-switcher a { color: #777d84; font: 500 .62rem 'IBM Plex Mono', monospace; text-decoration: none; }
	.language-switcher a:hover, .language-switcher a[aria-current=page] { color: #c7f04b; }
	.side-nav { position: fixed; z-index: 20; top: 50%; right: 1.25rem; display: flex; flex-direction: column; gap: .2rem; align-items: flex-end; transform: translateY(-50%); }
	.side-nav a { display: flex; gap: .65rem; align-items: center; padding: .38rem 0; color: #777d84; font-size: .7rem; text-decoration: none; text-shadow: 0 1px 8px #0b0d0f; transition: color 160ms ease, transform 160ms ease; }
	.side-nav b { font-weight: 400; transform: scaleX(-1); transition: transform 260ms cubic-bezier(.2,.8,.2,1), color 160ms ease; }
	.side-nav i { width: .8rem; height: 1px; background: currentColor; transition: width 160ms ease; }
	.side-nav a:hover { color: #f2f0ea; transform: translateX(-.2rem); }
	.side-nav a:hover b, .side-nav a:focus-visible b { transform: scaleX(1); }
	.side-nav a:hover i { width: 1.5rem; color: #c7f04b; }
	.side-nav span { color: #c7f04b; font: 500 .58rem 'IBM Plex Mono', monospace; }
	.to-top { position: fixed; z-index: 20; right: 1rem; bottom: 1rem; display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid rgb(242 240 234 / 14%); background: #15181c; color: #f2f0ea; text-decoration: none; transition: transform 160ms ease, background 160ms ease; }
	.to-top:hover { background: #6657c8; transform: translateY(-3px); }
	main { max-width: 90rem; margin: 0 auto; }
	section { display: grid; align-content: center; min-height: calc(100svh - 6rem); padding: clamp(5rem, 12vh, 9rem) clamp(1.5rem, 8vw, 8rem); }
	.eyebrow { margin: 0 0 2rem; color: #9ba1a8; text-transform: uppercase; }
	.eyebrow::before { display: inline-block; width: .45rem; height: .45rem; margin-right: .75rem; background: #c7f04b; content: ''; }
	h1 { max-width: 12ch; margin: 0; font-size: clamp(3.25rem, 8vw, 7.5rem); font-weight: 500; letter-spacing: -.065em; line-height: .94; }
	h1 em { color: #c7f04b; font-style: normal; }
	.intro { max-width: 39rem; margin: 2.5rem 0; color: #b9bdc1; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.7; }
	.button { justify-self: start; padding: 1rem 1.25rem; background: #c7f04b; color: #0b0d0f; font-size: .9rem; font-weight: 600; text-decoration: none; transition: background 180ms ease, transform 180ms ease; }
	.button:hover { background: #d8ff66; transform: translateY(-2px); }
	.languages { margin: 1.25rem 0 0; color: #777d84; font-size: .8rem; }
	footer { display: flex; justify-content: space-between; padding: 2rem clamp(1.5rem, 5vw, 5rem); border-top: 1px solid rgb(242 240 234 / 10%); background: #15181c; }
	footer p { margin: 0; color: #9ba1a8; }
	footer small { display: block; margin-bottom: .65rem; color: #c7f04b; font: 500 .62rem 'IBM Plex Mono', monospace; letter-spacing: .13em; }
	.contact-action { display: flex; align-items: flex-end; flex-direction: column; gap: .65rem; text-align: right; }
	.contact-action span { color: #9ba1a8; }
	.contact-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .65rem 1.25rem; }
	footer a { color: #f2f0ea; font-weight: 600; text-underline-offset: .3rem; transition: color 160ms ease; }
	footer a:hover { color: #c7f04b; }
	:focus-visible { outline: 2px solid #f2f0ea; outline-offset: 4px; }
	@media (max-width: 40rem) {
		.header-cta { display: none; }
		footer { align-items: flex-start; flex-direction: column; gap: 1.5rem; padding-bottom: calc(7rem + env(safe-area-inset-bottom)); }
		.contact-action { align-items: flex-start; text-align: left; }
		.contact-links { align-items: flex-start; flex-direction: column; gap: 0; }
		.contact-action a { display: inline-flex; min-height: 2.75rem; align-items: center; }
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.button { transition: none; }
	}
	.services { grid-template-columns: minmax(16rem, .65fr) minmax(25rem, 1.35fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; min-height: auto; border-top: 1px solid rgb(242 240 234 / 10%); background: #111316; }
	.section-heading { align-self: start; position: sticky; top: 3rem; }
	.section-heading h2 { max-width: 12ch; margin: 0; font-size: clamp(2rem, 4vw, 3.75rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; }
	.service-stack { min-height: 240vh; }
	.service-panel { position: sticky; top: 3rem; display: flex; flex-direction: column; justify-content: space-between; min-height: min(36rem, calc(100vh - 6rem)); padding: clamp(1.5rem, 3vw, 3rem); overflow: hidden; border: 1px solid rgb(242 240 234 / 14%); background: #191c20; box-shadow: 0 2rem 5rem rgb(0 0 0 / 28%); transform: translateX(var(--panel-shift, 0)) scale(var(--panel-scale, 1)); transform-origin: top center; will-change: transform; }
	.service-panel + .service-panel { top: 5rem; margin-top: 48vh; background: #202328; }
	.service-panel:nth-child(3) { top: 7rem; background: #272a30; }
	.service-panel::after { position: absolute; right: -5rem; bottom: -7rem; width: 19rem; height: 19rem; border: 1px solid rgb(102 87 200 / 38%); content: ''; transform: rotate(35deg); }
	.panel-top { display: flex; justify-content: space-between; color: #9ba1a8; font: 500 .65rem 'IBM Plex Mono', monospace; letter-spacing: .1em; }
	.service-panel h3 { max-width: 10ch; margin: 0 0 1.25rem; font-size: clamp(2.2rem, 4vw, 4rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
	.service-panel p { max-width: 34rem; margin: 0; color: #b9bdc1; font-size: 1.05rem; line-height: 1.7; }
	.service-panel strong { position: relative; z-index: 1; max-width: 28rem; color: #9ba1a8; font-size: .8rem; font-weight: 500; letter-spacing: .03em; }
	@media (max-width: 52rem) {
		.services { grid-template-columns: 1fr; }
		.section-heading { position: static; }
