<script>
	const panels = document.querySelectorAll('.service-panel');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let ticking = false;

	const updatePanels = () => {
		if (reduceMotion.matches) return;
		panels.forEach((panel, index) => {
			const next = panels[index + 1];
			if (!next) return;
			const progress = Math.max(0, Math.min(1, (innerHeight - next.getBoundingClientRect().top) / (innerHeight * .58)));
			const element = panel as HTMLElement;
			element.style.setProperty('--panel-shift', (progress * -18) + 'px');
			element.style.setProperty('--panel-scale', String(1 - progress * .045));
		});
		ticking = false;
	};

	addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(updatePanels); ticking = true; } }, { passive: true });
	addEventListener('resize', updatePanels);
	updatePanels();

	const navLinks = Array.from(document.querySelectorAll('.side-nav a'));
	const activateNavLink = (id: string) => {
		navLinks.forEach((link) => {
			const active = link.getAttribute('href') === '#' + id;
			link.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	const sectionObserver = new IntersectionObserver((entries) => {
		const visible = entries.find((entry) => entry.isIntersecting);
		if (visible) activateNavLink(visible.target.id);
	}, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });

	document.querySelectorAll('#services, #portfolio, #approach, #about, #contact').forEach((section) => sectionObserver.observe(section));
	activateNavLink('services');
</script>
