---
const title = 'Affordable web design in Gistel | Bits by Tommy';
const description = 'Personal and affordable web design in Gistel and surrounding areas. A clear custom website that belongs to you and can grow with your business.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Bits by Tommy',
	url: canonicalURL.href,
	email: 'vercruyssetommy@telenet.be',
	telephone: '+32493767863',
	description,
	areaServed: { '@type': 'City', name: 'Gistel' },
	founder: { '@type': 'Person', name: 'Tommy' },
	knowsLanguage: ['nl', 'fr', 'en'],
	serviceType: 'Web design',
};
const faqData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'How much does a website cost?',
			acceptedAnswer: { '@type': 'Answer', text: 'A straightforward one-page website usually costs around €500 excluding VAT. A straightforward website with up to three pages is around €750 excluding VAT. These are guide prices. Custom design, animation and specific features all affect the amount of work involved.' },
		},
		{
			'@type': 'Question',
			name: 'Will I really own my website?',
			acceptedAnswer: { '@type': 'Answer', text: 'Yes. You buy your website rather than rent it. There is no mandatory maintenance subscription. Your domain name remains the main recurring annual cost unless you choose additional paid services.' },
		},
		{
			'@type': 'Question',
			name: 'Can I update the website myself?',
			acceptedAnswer: { '@type': 'Answer', text: 'Yes. You can easily update existing text, photos, prices and other content. If you need new pages or features later, we can discuss a clearly scoped extension.' },
		},
		{
			'@type': 'Question',
			name: 'Do you only work with clients in Gistel?',
			acceptedAnswer: { '@type': 'Answer', text: 'No. Bits by Tommy works from Gistel with small businesses, associations and projects in the surrounding area and beyond. Much of the process can easily be handled remotely.' },
		},
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="nl-BE" href="https://bitsbytommy.be/" />
		<link rel="alternate" hreflang="fr-BE" href="https://bitsbytommy.be/fr/" />
		<link rel="alternate" hreflang="en" href="https://bitsbytommy.be/en/" />
		<link rel="alternate" hreflang="x-default" href="https://bitsbytommy.be/" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:site_name" content="Bits by Tommy" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqData)} />
		<title>{title}</title>
	</head>
	<body id=top>
		<header>
			<a href=/>bits <small>BY TOMMY</small></a>
			<div class=header-actions>
				<nav class=language-switcher aria-label=Language><a href=/>NL</a><a href=/fr/>FR</a><a href=/en/ aria-current=page>EN</a></nav>
				<a class=header-cta href=#contact>Tell me what you need</a>
			</div>
		</header>
		<nav class=side-nav aria-label='Main navigation'>
			<a href=#services data-secondary><b>Vision</b><i aria-hidden=true></i><span>01</span></a>
			<a href=#portfolio><b>Portfolio</b><i aria-hidden=true></i><span>02</span></a>
			<a href=#approach data-secondary><b>Process</b><i aria-hidden=true></i><span>03</span></a>
			<a href=#pricing><b>Pricing</b><i aria-hidden=true></i><span>04</span></a>
			<a href=#faq><b>FAQ</b><i aria-hidden=true></i><span>05</span></a>
			<a href=#about data-secondary><b>About</b><i aria-hidden=true></i><span>06</span></a>
			<a href=#contact><b>Contact</b><i aria-hidden=true></i><span>07</span></a>
		</nav>
		<main><section>
			<p class=eyebrow>Web design in Gistel</p>
			<h1>Your idea. My bits. <em>A website that feels right.</em></h1>
			<p class=intro>I get to know your business, organisation or idea and turn it into a clear, affordable website with a character of its own.</p>
			<a class=button href=#contact>Tell me your idea ↘</a>
			<p class=languages>For small businesses, associations and people with a good idea.</p>
		</section>
		<section class=services id=services aria-labelledby=services-title>
			<div class=section-heading>
				<p class=eyebrow>How I build websites</p>
				<h2 id=services-title>No rigid packages. A proper conversation.</h2>
			</div>
			<div class=service-stack>
				<article class=service-panel>
					<div class=panel-top><span>01 / YOU</span><span>YOUR INPUT</span></div>
					<div><h3>You know your story.</h3><p>I listen to what you do, who you do it for and where you want to go. That knowledge becomes the foundation of the design.</p></div>
					<strong>Your input sets the direction. I turn it into a website.</strong>
				</article>
				<article class=service-panel>
					<div class=panel-top><span>02 / SIMPLICITY</span><span>ONLY WHAT WORKS</span></div>
					<div><h3>Simplicity is a choice.</h3><p>A clear structure, strong visuals and thoughtful details. Everything has a purpose. Nothing gets in your visitor’s way.</p></div>
					<strong>Good to look at. Easy to use.</strong>
				</article>
				<article class=service-panel>
					<div class=panel-top><span>03 / VALUE</span><span>HONEST BUDGET</span></div>
					<div><h3>Affordable, with character.</h3><p>An affordable website does not have to feel cheap. You pay for considered design and solid work, not the name of a large agency.</p></div>
					<strong>An original website without a baffling invoice.</strong>
				</article>
			</div>
		</section>
		<section class=portfolio id=portfolio aria-labelledby=portfolio-title>
			<div class=portfolio-heading>
				<p class=eyebrow>Portfolio</p>
				<h2 id=portfolio-title>One project. Completely real.</h2>
				<p>My portfolio grows along with Bits by Tommy. This is where it starts today.</p>
			</div>
			<a class=project-card href=https://maramusic.be/ target=_blank rel=noreferrer>
				<div class=project-visual>
					<span class=project-window>maramusic.be</span>
					<img src=/mara-portfolio.png alt='Example of the multilingual artist website Maramusic.be' loading=lazy />
				</div>
				<div class=project-info>
					<div><span>01 / MUSIC</span><h3>Maramusic.be</h3><p>A multilingual artist website</p></div>
					<strong>View the website ↗</strong>
				</div>
			</a>
		</section>
		<section class=approach id=approach aria-labelledby=approach-title>
			<div class=approach-copy>
				<p class=eyebrow>A clear process</p>
				<h2 id=approach-title>Listen first. Design second.</h2>
				<p>We create the plan together. I then take care of the design and implementation. At agreed moments, you can review the work and steer it where needed.</p>
			</div>
			<ol class=process>
				<li><span>01</span><div><h3>Understand first</h3><p>We discuss your story, your audience and what the website needs to achieve.</p></div></li>
				<li><span>02</span><div><h3>A clear plan</h3><p>I turn our conversation into a concrete proposal with a clear structure, price and timeline.</p></div></li>
				<li><span>03</span><div><h3>Design and build</h3><p>I get to work independently. At agreed moments, we review the result and collect your feedback.</p></div></li>
			</ol>
		</section>
		<section class=pricing id=pricing aria-labelledby=pricing-title>
			<div class=pricing-heading>
				<p class=eyebrow>Guide prices</p>
				<h2 id=pricing-title>Start clearly. Keep room to grow.</h2>
				<p>No rigid packages you have to fit into. Just two clear examples to help you estimate your budget.</p>
			</div>
			<div class=price-options>
				<article>
					<div><span>ONE PAGE</span><strong>± €500 <small>excl. VAT</small></strong></div>
					<h3>Strong on one page.</h3>
					<ul>
						<li>Custom design</li>
						<li><strong>One clear scrolling page</strong></li>
						<li>Designed for mobile, tablet and desktop</li>
						<li>Contact details and clickable contact buttons</li>
						<li><strong>Technical SEO foundation</strong></li>
						<li>One consolidated feedback round</li>
						<li>Publication and technical configuration</li>
					</ul>
				</article>
				<article>
					<div><span>UP TO THREE PAGES</span><strong>± €750 <small>excl. VAT</small></strong></div>
					<h3>More room for your story.</h3>
					<ul>
						<li>Custom design</li>
						<li><strong>Up to three separate pages</strong></li>
						<li>Designed for mobile, tablet and desktop</li>
						<li>Contact details and clickable contact buttons</li>
						<li><strong>A dedicated SEO title and description for each page</strong></li>
						<li>One consolidated feedback round</li>
						<li>Publication and technical configuration</li>
					</ul>
				</article>
				<p class=price-note>Text and images are supplied by the client. Online shops, multilingual content and special features are not included and are discussed separately in advance.</p>
			</div>
			<p class=pricing-context>These are guide prices, not fixed packages. A highly customised page with animation or specific features can require more work than three straightforward pages. You always receive a clear price in advance.</p>
		</section>
		<section class=ownership id=ownership aria-labelledby=ownership-title>
			<div>
				<p class=eyebrow>Honest ownership</p>
				<h2 id=ownership-title>You buy your website. You do not rent it.</h2>
			</div>
			<div class=ownership-copy>
				<p>The website I build for you belongs to you. There is no mandatory maintenance subscription and no monthly bill simply to keep your own website online.</p>
				<ul>
					<li><span>EDIT IT</span><p>Easily update existing text, photos, prices, menus and other content yourself.</p></li>
					<li><span>LET IT GROW</span><p>Need a new page, link or feature later? You receive a clear proposal in advance.</p></li>
					<li><span>ANNUAL COST</span><p>Your domain name remains your only fixed cost unless you choose an additional paid service.</p></li>
				</ul>
			</div>
		</section>
		<section class=faq id=faq aria-labelledby=faq-title>
			<div class=faq-heading>
				<p class=eyebrow>Frequently asked questions</p>
				<h2 id=faq-title>A new website without the question marks.</h2>
			</div>
			<div class=faq-list>
				<details><summary>How much does a website cost?</summary><p>A straightforward one-page website usually costs around €500 excluding VAT. A straightforward website with up to three pages is around €750 excluding VAT. These are guide prices. Custom design, animation and specific features all affect the amount of work involved.</p></details>
				<details><summary>Will I really own my website?</summary><p>Yes. You buy your website rather than rent it. There is no mandatory maintenance subscription. Your domain name remains the main recurring annual cost unless you choose additional paid services.</p></details>
				<details><summary>Can I update the website myself?</summary><p>Yes. You can easily update existing text, photos, prices and other content. If you need new pages or features later, we can discuss a clearly scoped extension.</p></details>
				<details><summary>Do you only work with clients in Gistel?</summary><p>No. I work from Gistel with small businesses, associations and projects in the surrounding area and beyond. Much of the process can easily be handled remotely.</p></details>
			</div>
		</section>
		<section class=about id=about aria-labelledby=about-title>
			<div class=about-marker aria-hidden=true>
				<span>11</span>
				<small>YEARS OLD<br />WHERE IT STARTED</small>
			</div>
			<div class=about-copy>
				<p class=eyebrow>About Tommy</p>
				<h2 id=about-title>Old curiosity. Fresh enthusiasm.</h2>
				<p>At eleven, I was already installing computers with Windows 98 and experimenting with my first websites. I built my first proper sites around twenty years ago.</p>
				<p>Technology remained part of my life and work, although web design was not always at the centre of it. Over the past few years, that interest returned. This year, I decided to take it seriously with fresh ideas and modern tools.</p>
				<p>Alongside Bits by Tommy, I work full time as a telecom service engineer. At home, I am first and foremost a partner and dad. And when there is an evening left over, I rarely say no to a good gaming session.</p>
				<p class=about-signoff>I want to create something we can both be proud of. Personal, understandable and without unnecessary costs.</p>
			</div>
		</section>
	</main>
		<footer id=contact>
			<div><small>WEB DESIGN IN GISTEL & SURROUNDING AREAS</small><p>Have something in mind?</p></div>
			<div class=contact-action>
				<span>Tell me about it, even if you are not completely sure yet.</span>
				<div class=contact-links>
					<a href=mailto:vercruyssetommy@telenet.be>vercruyssetommy@telenet.be ↗</a>
					<a href=tel:+32493767863>0493 76 78 63 ↗</a>
				</div>
			</div>
		</footer>
		<a class=to-top href=#top aria-label='Back to top'>↑</a>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Manrope:wght@400;500;600&display=swap');
	:root { color-scheme: dark; font-family: 'Manrope', sans-serif; background: #0b0d0f; color: #f2f0ea; }
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; min-width: 320px; background: radial-gradient(circle at 78% 22%, rgb(143 41 66 / 12%), transparent 28rem), #0b0d0f; }
	a { color: inherit; }
	header { display: flex; align-items: center; justify-content: space-between; max-width: 90rem; margin: 0 auto; padding: 1.75rem clamp(1.5rem, 5vw, 5rem); border-bottom: 1px solid rgb(242 240 234 / 10%); }
	header a { font-size: .85rem; text-underline-offset: .35rem; }
	header > a:first-child { font-size: 1.65rem; font-weight: 600; letter-spacing: -.08em; text-decoration: none; }
	header small, .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: .68rem; letter-spacing: .14em; }
	header small { margin-left: .75rem; color: #9ba1a8; }
	.header-actions { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
	.language-switcher { display: flex; gap: .65rem; }
	.language-switcher a { color: #777d84; font: 500 .62rem 'IBM Plex Mono', monospace; text-decoration: none; }
	.language-switcher a:hover, .language-switcher a[aria-current=page] { color: #c7f04b; }
	.side-nav { position: fixed; z-index: 20; top: 50%; right: 1.25rem; display: flex; flex-direction: column; gap: .2rem; align-items: flex-end; transform: translateY(-50%); }
	.side-nav a { display: flex; gap: .65rem; align-items: center; padding: .38rem 0; color: #777d84; font-size: .7rem; text-decoration: none; text-shadow: 0 1px 8px #0b0d0f; transition: color 160ms ease, transform 160ms ease; }
	.side-nav b { font-weight: 400; transform: scaleX(-1); transition: transform 260ms cubic-bezier(.2,.8,.2,1), color 160ms ease; }
	.side-nav i { width: .8rem; height: 1px; background: currentColor; transition: width 160ms ease; }
	.side-nav a:hover { color: #f2f0ea; transform: translateX(-.2rem); }
	.side-nav a:hover b, .side-nav a:focus-visible b { transform: scaleX(1); }
	.side-nav a:hover i { width: 1.5rem; color: #c7f04b; }
	.side-nav span { color: #c7f04b; font: 500 .58rem 'IBM Plex Mono', monospace; }
	.to-top { position: fixed; z-index: 20; right: 1rem; bottom: 1rem; display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid rgb(242 240 234 / 14%); background: #15181c; color: #f2f0ea; text-decoration: none; transition: transform 160ms ease, background 160ms ease; }
	.to-top:hover { background: #6657c8; transform: translateY(-3px); }
	main { max-width: 90rem; margin: 0 auto; }
	section { display: grid; align-content: center; min-height: calc(100svh - 6rem); padding: clamp(5rem, 12vh, 9rem) clamp(1.5rem, 8vw, 8rem); }
	.eyebrow { margin: 0 0 2rem; color: #9ba1a8; text-transform: uppercase; }
	.eyebrow::before { display: inline-block; width: .45rem; height: .45rem; margin-right: .75rem; background: #c7f04b; content: ''; }
	h1 { max-width: 12ch; margin: 0; font-size: clamp(3.25rem, 8vw, 7.5rem); font-weight: 500; letter-spacing: -.065em; line-height: .94; }
	h1 em { color: #c7f04b; font-style: normal; }
	.intro { max-width: 39rem; margin: 2.5rem 0; color: #b9bdc1; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.7; }
	.button { justify-self: start; padding: 1rem 1.25rem; background: #c7f04b; color: #0b0d0f; font-size: .9rem; font-weight: 600; text-decoration: none; transition: background 180ms ease, transform 180ms ease; }
	.button:hover { background: #d8ff66; transform: translateY(-2px); }
	.languages { margin: 1.25rem 0 0; color: #777d84; font-size: .8rem; }
	footer { display: flex; justify-content: space-between; padding: 2rem clamp(1.5rem, 5vw, 5rem); border-top: 1px solid rgb(242 240 234 / 10%); background: #15181c; }
	footer p { margin: 0; color: #9ba1a8; }
	footer small { display: block; margin-bottom: .65rem; color: #c7f04b; font: 500 .62rem 'IBM Plex Mono', monospace; letter-spacing: .13em; }
	.contact-action { display: flex; align-items: flex-end; flex-direction: column; gap: .65rem; text-align: right; }
	.contact-action span { color: #9ba1a8; }
	.contact-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .65rem 1.25rem; }
	footer a { color: #f2f0ea; font-weight: 600; text-underline-offset: .3rem; transition: color 160ms ease; }
	footer a:hover { color: #c7f04b; }
	:focus-visible { outline: 2px solid #f2f0ea; outline-offset: 4px; }
	@media (max-width: 40rem) {
		.header-cta { display: none; }
		footer { align-items: flex-start; flex-direction: column; gap: 1.5rem; padding-bottom: calc(7rem + env(safe-area-inset-bottom)); }
		.contact-action { align-items: flex-start; text-align: left; }
		.contact-links { align-items: flex-start; flex-direction: column; gap: 0; }
		.contact-action a { display: inline-flex; min-height: 2.75rem; align-items: center; }
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.button { transition: none; }
	}
	.services { grid-template-columns: minmax(16rem, .65fr) minmax(25rem, 1.35fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; min-height: auto; border-top: 1px solid rgb(242 240 234 / 10%); background: #111316; }
	.section-heading { align-self: start; position: sticky; top: 3rem; }
	.section-heading h2 { max-width: 12ch; margin: 0; font-size: clamp(2rem, 4vw, 3.75rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; }
	.service-stack { min-height: 240vh; }
	.service-panel { position: sticky; top: 3rem; display: flex; flex-direction: column; justify-content: space-between; min-height: min(36rem, calc(100vh - 6rem)); padding: clamp(1.5rem, 3vw, 3rem); overflow: hidden; border: 1px solid rgb(242 240 234 / 14%); background: #191c20; box-shadow: 0 2rem 5rem rgb(0 0 0 / 28%); transform: translateX(var(--panel-shift, 0)) scale(var(--panel-scale, 1)); transform-origin: top center; will-change: transform; }
	.service-panel + .service-panel { top: 5rem; margin-top: 48vh; background: #202328; }
	.service-panel:nth-child(3) { top: 7rem; background: #272a30; }
	.service-panel::after { position: absolute; right: -5rem; bottom: -7rem; width: 19rem; height: 19rem; border: 1px solid rgb(102 87 200 / 38%); content: ''; transform: rotate(35deg); }
	.panel-top { display: flex; justify-content: space-between; color: #9ba1a8; font: 500 .65rem 'IBM Plex Mono', monospace; letter-spacing: .1em; }
	.service-panel h3 { max-width: 10ch; margin: 0 0 1.25rem; font-size: clamp(2.2rem, 4vw, 4rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
	.service-panel p { max-width: 34rem; margin: 0; color: #b9bdc1; font-size: 1.05rem; line-height: 1.7; }
	.service-panel strong { position: relative; z-index: 1; max-width: 28rem; color: #9ba1a8; font-size: .8rem; font-weight: 500; letter-spacing: .03em; }
	@media (max-width: 52rem) {
		.services { grid-template-columns: 1fr; }
		.section-heading { position: static; }
		.service-stack { min-height: 220vh; }
	}
	@media (max-width: 30rem) {
		.service-panel { min-height: 31rem; }
		.service-panel + .service-panel { margin-top: 38vh; }
	}
	.portfolio { grid-template-columns: minmax(16rem, .55fr) minmax(25rem, 1.45fr); gap: clamp(3rem, 7vw, 7rem); min-height: auto; border-top: 1px solid rgb(242 240 234 / 10%); }
	.portfolio-heading h2 { max-width: 11ch; margin: 0; font-size: clamp(2.4rem, 4.5vw, 4.5rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }
	.portfolio-heading > p:last-child { max-width: 25rem; margin: 1.75rem 0 0; color: #9ba1a8; line-height: 1.7; }
	.project-card { display: grid; color: inherit; text-decoration: none; }
	.project-visual { position: relative; display: grid; min-height: clamp(22rem, 45vw, 37rem); place-items: center; overflow: hidden; border: 1px solid rgb(242 240 234 / 13%); background: #15181c; }
	.project-window { position: absolute; z-index: 2; top: 1rem; left: 1rem; padding: .45rem .6rem; background: rgb(11 13 15 / 78%); color: #f2f0ea; font: 500 .62rem 'IBM Plex Mono', monospace; letter-spacing: .1em; }
	.project-visual img { width: 100%; height: 100%; min-height: inherit; object-fit: cover; transition: transform 700ms cubic-bezier(.2,.8,.2,1), filter 700ms ease; }
	.project-card:hover .project-visual img { filter: brightness(1.08); transform: scale(1.025); }
	.project-info { display: flex; justify-content: space-between; gap: 2rem; padding: 1.5rem 0; border-bottom: 1px solid rgb(242 240 234 / 13%); }
	.project-info span { color: #c7f04b; font: 500 .62rem 'IBM Plex Mono', monospace; letter-spacing: .1em; }
	.project-info h3 { margin: .6rem 0 .4rem; font-size: 1.35rem; font-weight: 500; }
	.project-info p, .project-info > strong { margin: 0; color: #9ba1a8; font-size: .85rem; font-weight: 500; line-height: 1.5; }
	.approach { grid-template-columns: minmax(18rem, 1fr) minmax(22rem, 1fr); gap: clamp(4rem, 10vw, 10rem); min-height: auto; overflow: hidden; position: relative; }
